{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "maistep",
  "version": "0.1.9",
  "identifier": "com.maistep.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "maistep",
        "width": 1600,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 680,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
