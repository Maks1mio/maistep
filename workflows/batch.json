{
  "title": "Пакетная обработка",
  "about": "Список строк → LLM по каждой → один файл в output/.",
  "nodes": [
    {
      "id": "n1",
      "type": "value.text",
      "x": 40,
      "y": 60,
      "props": {
        "text": "яблоко\nгруша\nслива"
      },
      "title": "Список"
    },
    {
      "id": "n2",
      "type": "text.split",
      "x": 380,
      "y": 60,
      "props": {}
    },
    {
      "id": "n3",
      "type": "llm.map",
      "x": 720,
      "y": 40,
      "props": {
        "template": "Один факт про {item}, одним предложением."
      }
    },
    {
      "id": "n4",
      "type": "output.save_text",
      "x": 1080,
      "y": 60,
      "props": {
        "name": "facts.md"
      }
    }
  ],
  "links": [
    {
      "from": "n1",
      "out": "text",
      "to": "n2",
      "in": "text"
    },
    {
      "from": "n2",
      "out": "list",
      "to": "n3",
      "in": "items"
    },
    {
      "from": "n3",
      "out": "text",
      "to": "n4",
      "in": "text"
    }
  ]
}
