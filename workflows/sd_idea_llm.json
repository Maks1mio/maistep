      },
      "title": "Идея"
    },
    {
      "id": "llm",
      "type": "llm.chat",
      "x": 380,
      "y": 0,
      "props": {
        "system": "Turn the idea into a prompt for an SDXL / Illustrious anime model: English danbooru-style tags separated by commas, start with masterpiece, best quality, amazing quality. Output only the tags.",
