        "effort": "low"
      },
      "title": "Промпт-инженер"
    },
    {
      "id": "ckpt",
      "type": "sd.checkpoint",
      "x": 720,
      "y": 200,
      "props": {
        "ckpt_name": "waiIllustriousSDXL_v160.safetensors"
      }
    },
    {
      "id": "skip",
      "type": "sd.clip_skip",
      "x": 1060,
      "y": 40,
      "props": {
        "stop_at_clip_layer": -2
      }
    },
    {
      "id": "pos",
      "type": "sd.text_encode",
      "x": 1400,
      "y": 0,
      "props": {
        "text": ""
      },
      "title": "Positive"
    },
    {
      "id": "neg",
      "type": "sd.text_encode",
      "x": 1400,
      "y": 190,
      "props": {
        "text": "lowres, worst quality, bad quality, bad anatomy, bad hands, extra fingers, watermark, text, signature"
      },
      "title": "Negative"
    },
    {
      "id": "latent",
      "type": "sd.empty_latent",
      "x": 1400,
      "y": 400,
      "props": {
        "width": 832,
        "height": 1216,
        "batch_size": 1
      }
    },
    {
      "id": "sampler",
      "type": "sd.ksampler",
      "x": 1740,
      "y": 60,
      "props": {
        "seed": -1,
        "steps": 25,
        "cfg": 6.0,
        "sampler_name": "euler_ancestral",
        "scheduler": "normal",
        "denoise": 1.0
      }
    },
    {
      "id": "decode",
      "type": "sd.vae_decode",
      "x": 2080,
      "y": 60,
      "props": {}
    },
    {
      "id": "save",
      "type": "image.save",
      "x": 2420,
      "y": 60,
      "props": {
        "prefix": "idea"
      }
