{
  "$schema": "https://app.kilo.ai/config.json",
  "mcp": {
    "maistep": {
      "type": "local",
      "command": [".venv/Scripts/python.exe", "mcp/maistep_mcp.py"],
      "environment": {
        "MAISTEP_URL": "http://127.0.0.1:3300"
      },
      "enabled": true,
      "timeout": 30000
    }
  }
}
