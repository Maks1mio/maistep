{
  "ckpt": {"class_type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": "waiIllustriousSDXL_v160.safetensors"}, "_meta": {"title": "Чекпоинт"}},
  "skip": {"class_type": "CLIPSetLastLayer", "inputs": {"clip": ["ckpt", 1], "stop_at_clip_layer": -2}, "_meta": {"title": "Clip skip"}},
  "pos": {"class_type": "CLIPTextEncode", "inputs": {"text": "masterpiece, best quality, scenery", "clip": ["skip", 0]}, "_meta": {"title": "Positive"}},
  "neg": {"class_type": "CLIPTextEncode", "inputs": {"text": "lowres, worst quality, watermark, text", "clip": ["skip", 0]}, "_meta": {"title": "Negative"}},
  "latent": {"class_type": "EmptyLatentImage", "inputs": {"width": 832, "height": 1216, "batch_size": 1}, "_meta": {"title": "Размер"}},
  "sample": {"class_type": "KSampler", "inputs": {"model": ["ckpt", 0], "seed": 1, "steps": 20, "cfg": 6, "sampler_name": "euler_ancestral", "scheduler": "normal", "positive": ["pos", 0], "negative": ["neg", 0], "latent_image": ["latent", 0], "denoise": 1}, "_meta": {"title": "Сэмплер"}},
  "decode": {"class_type": "VAEDecode", "inputs": {"samples": ["sample", 0], "vae": ["ckpt", 2]}, "_meta": {"title": "Декодирование"}},
  "out": {"class_type": "PreviewImage", "inputs": {"images": ["decode", 0]}, "_meta": {"title": "Результат"}}
}
